# Terminazione TLS per il portale (§9.4, §19).
#
# "tls internal" usa la CA interna generata e gestita automaticamente da Caddy: funziona
# offline, senza bisogno di un dominio pubblico o di Internet — adatto a un deployment
# puramente su rete LAN come questo. Il browser segnalerà "certificato non attendibile"
# finché non importi la CA generata (deploy/scripts/trust-caddy-ca.sh) o non sostituisci
# questo blocco con un certificato reale, se un giorno il portale diventa raggiungibile da
# Internet con un dominio proprio.
{
	auto_https off
}

:443 {
	tls internal

	reverse_proxy ups-web:8080
}
