# Segreti del Safety Agent.
#
# Installazione:
#   sudo install -d -m 0750 -o root -g upsagent /etc/ups-control-center
#   sudo install -m 0640 -o root -g upsagent safety-agent.env.example \
#        /etc/ups-control-center/safety-agent.env
#
# Il file deve essere leggibile dal gruppo upsagent ma non da tutti: contiene
# le credenziali con cui l'agent si autentica verso il portale.

# Chiave HMAC per verificare la firma della configurazione.
# DEVE coincidere con SAFETY_CONFIG_HMAC_KEY del docker-compose.
SafetyAgent__ConfigHmacKeyBase64=

# Token di autenticazione verso il portale.
# DEVE coincidere con SAFETY_AGENT_TOKEN del docker-compose.
SafetyAgent__AgentToken=

# Endpoint del portale. L'agent chiama in uscita e non apre porte in ingresso.
# Deve coincidere con BIND_ADDRESS: il certificato della CA interna di Caddy è emesso per
# quell'IP e la porta Docker non è pubblicata sul loopback.
SafetyAgent__ControlPlaneBaseUrl=https://10.0.0.8:8443

SafetyAgent__DatabasePath=/var/lib/ups-control-center/safety.db
SafetyAgent__KillSwitchPath=/var/lib/ups-control-center/AUTOMATION_DISABLED
SafetyAgent__ConfigPullIntervalSeconds=60

# NON impostare a true in produzione: accetterebbe configurazioni non autenticate.
SafetyAgent__AllowUnsignedConfigForDevelopment=false

# NUT locale, su loopback.
Nut__Host=127.0.0.1
Nut__Port=3493
Nut__UpsName=riello
Nut__TimeoutSeconds=5
