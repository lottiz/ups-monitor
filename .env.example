# ============================================================================
# UPS Control Center — configurazione di deployment
#
# Copiare in .env e compilare. Il file .env NON va versionato e deve avere
# permessi 0600: contiene segreti.
#
#   cp .env.example .env && chmod 600 .env
#
# Generazione dei segreti:
#   openssl rand -base64 48
# ============================================================================

# ----------------------------------------------------------------- PostgreSQL
POSTGRES_DB=upscc
POSTGRES_USER=upscc
# OBBLIGATORIA. Generare con: openssl rand -base64 36
POSTGRES_PASSWORD=

# ----------------------------------------------------------------- immagini
IMAGE_REGISTRY=local
# Tag esplicito: serve per il rollback (vedi docs/06 §6.9).
IMAGE_TAG=0.1.0

# ----------------------------------------------------------------- rete
# IP su cui pubblicare il portale. 127.0.0.1 per i test, 10.0.0.8 in produzione.
# NON usare 0.0.0.0: Docker scavalca UFW e il portale sarebbe esposto (docs/09 §9.4).
BIND_ADDRESS=127.0.0.1
WEB_PORT=8443

# ----------------------------------------------------------------- modalità
# VINCOLO DEL PROGETTO: il sistema nasce e resta in DryRun.
# Per abilitare LIVE non basta questo valore: serve anche UPS_ALLOW_LIVE=1
# nell'ambiente del servizio, l'abilitazione per singolo adapter e
# l'approvazione nell'interfaccia (docs/08 §8.2).
EXECUTION_MODE=DryRun

# ----------------------------------------------------------------- segreti
# Firma HMAC della configurazione distribuita al Safety Agent. Minimo 32 byte.
# OBBLIGATORIA. Generare con: openssl rand -base64 48
# Lo stesso valore va configurato nel Safety Agent sull'host.
SAFETY_CONFIG_HMAC_KEY=

# Token con cui il Safety Agent si autentica verso il portale.
# OBBLIGATORIO. Generare con: openssl rand -base64 32
SAFETY_AGENT_TOKEN=

# ----------------------------------------------------------------- NUT
# NUT gira sull'host, non in Docker.
#  - host.docker.internal : richiede una riga LISTEN aggiuntiva in upsd.conf
#                           (modifica all'host, da approvare: docs/09 §9.3)
#  - 10.0.0.8             : se upsd già ascolta su quell'indirizzo
NUT_HOST=host.docker.internal
NUT_PORT=3493
NUT_UPS_NAME=riello
NUT_POLLING_SECONDS=10

# ----------------------------------------------------------------- percorsi host
# Stato condiviso con il Safety Agent (file sentinella del kill switch).
HOST_STATE_DIR=/var/lib/ups-control-center
BACKUP_DIR=/var/backups/ups-control-center
BACKUP_RETENTION_DAYS=30

# ----------------------------------------------------------------- primo utente
# Usati SOLO dal job di migrazione per creare il primo amministratore.
# Rimuoverli da .env subito dopo il primo avvio e cambiare la password.
# Requisiti: almeno 12 caratteri, maiuscole, cifre e caratteri non alfanumerici.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ----------------------------------------------------------------- notifiche
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

WEBHOOK_ENABLED=false
# Per Microsoft Teams usare un flusso Power Automate / Workflows: i connettori
# Office 365 legacy sono deprecati da Microsoft (docs/10 R21).
WEBHOOK_URL=

# ----------------------------------------------------------------- risorse
# Verificare le risorse reali del mini PC PRIMA del deploy: nproc, free -h, df -h
# (docs/09 §9.1). Questi valori sono conservativi, non garantiti.
DB_CPU_LIMIT=1.0
DB_MEM_LIMIT=1g
WEB_CPU_LIMIT=1.0
WEB_MEM_LIMIT=512m
ORCHESTRATOR_CPU_LIMIT=0.5
ORCHESTRATOR_MEM_LIMIT=384m
NOTIFICATIONS_CPU_LIMIT=0.25
NOTIFICATIONS_MEM_LIMIT=256m
SIMULATOR_CPU_LIMIT=0.5
SIMULATOR_MEM_LIMIT=384m

# ----------------------------------------------------------------- varie
TZ=Europe/Rome
