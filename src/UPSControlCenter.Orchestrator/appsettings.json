{
  "Orchestrator": {
    "WorkerName": "ups-orchestrator",
    "HeartbeatIntervalSeconds": 15,
    "HealthSentinelPath": "/tmp/healthy",
    "KillSwitchPath": "/var/lib/ups-control-center/AUTOMATION_DISABLED",
    "DefaultMeasurementRetentionDays": 90,
    "MaintenanceIntervalMinutes": 60
  },
  "Nut": {
    "Host": "host.docker.internal",
    "Port": 3493,
    "UpsName": "riello",
    "TimeoutSeconds": 5,
    "PollingIntervalSeconds": 10,
    "StaleDataThresholdSeconds": 60
  },
  "Execution": {
    "Mode": "DryRun"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
