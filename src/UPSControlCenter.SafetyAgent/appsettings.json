{
  "SafetyAgent": {
    "DatabasePath": "/var/lib/ups-control-center/safety.db",
    "KillSwitchPath": "/var/lib/ups-control-center/AUTOMATION_DISABLED",
    "ControlPlaneBaseUrl": "https://127.0.0.1:8443",
    "ConfigHmacKeyBase64": "",
    "AgentToken": "",
    "ConfigPullIntervalSeconds": 60,
    "FallbackPollingIntervalSeconds": 10,
    "AllowUnsignedConfigForDevelopment": false
  },
  "Nut": {
    "Host": "127.0.0.1",
    "Port": 3493,
    "UpsName": "riello",
    "TimeoutSeconds": 5,
    "PollingIntervalSeconds": 10,
    "StaleDataThresholdSeconds": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  }
}
