@model DashboardViewModel
@inject DisplayTimeFormatter DisplayTime
@{
    ViewData["Title"] = "Dashboard";
}

<header class="page-heading">
    <div>
        <div class="eyebrow">Centro operativo</div>
        <h1>Panoramica sistema</h1>
        <p>Stato energetico, automazioni e infrastruttura in un unico colpo d'occhio.</p>
    </div>
    <div class="live-caption"><span class="live-pulse" aria-hidden="true"></span>Dati in tempo reale</div>
</header>

@* Banner della modalità: deve essere la prima cosa visibile. Confondere DRY_RUN con LIVE è il
   rischio operativo più grave del sistema (§15). *@
@if (Model.Automation.AutomationDisabled)
{
    <div class="alert alert-danger mode-banner d-flex align-items-center" role="alert">
        <strong class="me-2">Automazioni disabilitate.</strong>
        Il kill switch è attivo: il monitoraggio prosegue, nessuna sequenza verrà eseguita.
    </div>
}
else if (Model.Automation.ExecutionMode == ExecutionMode.DryRun)
{
    <div class="alert alert-info mode-banner d-flex align-items-center" role="alert">
        <strong class="me-2">Modalità DRY_RUN.</strong>
        Le regole vengono valutate e le sequenze registrate, ma nessun comando reale di
        spegnimento o accensione viene inviato ai dispositivi.
    </div>
}
else
{
    <div class="alert alert-warning mode-banner d-flex align-items-center" role="alert">
        <strong class="me-2">Modalità LIVE.</strong>
        Le operazioni reali sono possibili sugli adapter abilitati:
        @(Model.Automation.LiveEnabledAdapters.Count == 0
            ? "nessuno"
            : string.Join(", ", Model.Automation.LiveEnabledAdapters)).
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-12 col-lg-8">
        <div class="card panel-card h-100">
            <div class="card-header panel-header d-flex justify-content-between align-items-center">
                <span><span class="section-kicker">Energia</span><span class="section-title">Stato UPS</span></span>
                <small class="text-body-secondary">Aggiornamento in tempo reale</small>
            </div>
            <div class="card-body" id="upsCards">
                @if (Model.UpsList.Count == 0)
                {
                    <p class="text-body-secondary mb-0">
                        Nessun UPS configurato. Aggiungerne uno dalla sezione UPS.
                    </p>
                }
                @foreach (var ups in Model.UpsList)
                {
                    <partial name="_UpsCard" model="ups" />
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card panel-card h-100">
            <div class="card-header panel-header"><span class="section-kicker">Controllo</span><span class="section-title">Stato automazione</span></div>
            <div class="card-body">
                <dl class="row mb-0 small" id="automationPanel">
                    <dt class="col-7">Modalità</dt>
                    <dd class="col-5" id="autoMode">
                        @(Model.Automation.ExecutionMode == ExecutionMode.DryRun ? "DRY_RUN" : "LIVE")
                    </dd>

                    <dt class="col-7">Orchestratore</dt>
                    <dd class="col-5" id="autoOrchestrator">@Model.Automation.OrchestratorState</dd>

                    <dt class="col-7">Ultimo heartbeat</dt>
                    <dd class="col-5" id="autoOrchestratorHb">
                        @DisplayTime.Format(
                            Model.Automation.OrchestratorLastHeartbeat,
                            "HH:mm:ss",
                            "non disponibile")
                    </dd>

                    <dt class="col-7">Safety Agent</dt>
                    <dd class="col-5" id="autoAgent">@Model.Automation.SafetyAgentState</dd>

                    <dt class="col-7">Ultimo heartbeat</dt>
                    <dd class="col-5" id="autoAgentHb">
                        @DisplayTime.Format(
                            Model.Automation.SafetyAgentLastHeartbeat,
                            "HH:mm:ss",
                            "non disponibile")
                    </dd>

                    <dt class="col-7">Configurazione attiva</dt>
                    <dd class="col-5" id="autoConfig">
                        @(Model.Automation.ActiveConfigVersion > 0
                            ? $"v{Model.Automation.ActiveConfigVersion}"
                            : "nessuna pubblicata")
                    </dd>

                    <dt class="col-7">Blackout in corso</dt>
                    <dd class="col-5" id="autoBlackout">
                        @(Model.Automation.CurrentBlackoutId is null ? "no" : "sì")
                    </dd>

                    <dt class="col-7">Durata blackout</dt>
                    <dd class="col-5" id="autoBlackoutDuration">
                        @(Model.Automation.BlackoutDurationSeconds is { } d
                            ? TimeSpan.FromSeconds(d).ToString(@"hh\:mm\:ss")
                            : "—")
                    </dd>

                    <dt class="col-7">Autonomia residua</dt>
                    <dd class="col-5" id="autoRuntime">
                        @(Model.Automation.RemainingRuntimeSeconds is { } r
                            ? TimeSpan.FromSeconds(r).ToString(@"hh\:mm\:ss")
                            : "non disponibile")
                    </dd>

                    <dt class="col-7">Prossima soglia</dt>
                    <dd class="col-5" id="autoThreshold">
                        @(Model.Automation.SecondsToNextThreshold is { } s
                            ? TimeSpan.FromSeconds(s).ToString(@"hh\:mm\:ss")
                            : "—")
                    </dd>
                </dl>

                @if (Model.Automation.BasedOnUncertainData)
                {
                    <div class="alert alert-warning mt-3 mb-0 py-2 small" role="alert">
                        La valutazione corrente si basa su dati incerti o incompleti.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.UpsList.Count > 0)
{
    <section class="card panel-card mb-4" id="energyTrends">
        <div class="card-header panel-header trend-header">
            <span>
                <span class="section-kicker">Analisi energetica</span>
                <span class="section-title">Trend ultime 24 ore</span>
            </span>
            <div class="trend-controls">
                <label class="visually-hidden" for="trendUps">UPS visualizzato</label>
                <select class="form-select form-select-sm" id="trendUps">
                    @foreach (var ups in Model.UpsList)
                    {
                        <option value="@ups.Id">@ups.Name</option>
                    }
                </select>
                <span class="sample-caption">campione ogni 20 min</span>
            </div>
        </div>
        <div class="card-body">
            <div class="trend-loading" id="trendLoading" role="status">Caricamento grafici…</div>
            <div class="row g-3" id="trendCharts">
                <div class="col-12 col-xl-6">
                    <article class="chart-card chart-card-runtime">
                        <div class="chart-copy">
                            <span class="chart-icon" aria-hidden="true">⏱</span>
                            <div><h2>Autonomia residua</h2><p>Minuti disponibili stimati dall’UPS</p></div>
                        </div>
                        <div class="chart-shell"><canvas id="runtimeTrendChart" role="img" aria-label="Grafico dell’autonomia residua nelle ultime 24 ore"></canvas></div>
                    </article>
                </div>
                <div class="col-12 col-xl-6">
                    <article class="chart-card chart-card-capacity">
                        <div class="chart-copy">
                            <span class="chart-icon" aria-hidden="true">◒</span>
                            <div><h2>Autonomia e carico</h2><p>Quanta autonomia resta in funzione del carico</p></div>
                        </div>
                        <div class="chart-shell"><canvas id="capacityTrendChart" role="img" aria-label="Grafico dell’autonomia residua confrontata con il carico UPS nelle ultime 24 ore"></canvas></div>
                    </article>
                </div>
                <div class="col-12 col-xl-6">
                    <article class="chart-card chart-card-voltage">
                        <div class="chart-copy">
                            <span class="chart-icon" aria-hidden="true">ϟ</span>
                            <div><h2>Stabilità elettrica</h2><p>Tensione di ingresso e uscita</p></div>
                        </div>
                        <div class="chart-shell"><canvas id="voltageTrendChart" role="img" aria-label="Grafico delle tensioni di ingresso e uscita nelle ultime 24 ore"></canvas></div>
                    </article>
                </div>
                <div class="col-12 col-xl-6">
                    <article class="chart-card chart-card-current">
                        <div class="chart-copy">
                            <span class="chart-icon" aria-hidden="true">⚡</span>
                            <div><h2>Corrente (assorbimento)</h2><p>Corrente di uscita rilevata o stimata</p></div>
                        </div>
                        <div class="chart-shell"><canvas id="currentTrendChart" role="img" aria-label="Grafico della corrente di uscita nelle ultime 24 ore"></canvas></div>
                    </article>
                </div>
                <div class="col-12 col-xl-4">
                    <article class="chart-card chart-card-infra">
                        <div class="chart-copy">
                            <span class="chart-icon" aria-hidden="true">◎</span>
                            <div><h2>Infrastruttura</h2><p>Distribuzione dello stato corrente</p></div>
                        </div>
                        <div class="chart-shell chart-shell-donut"><canvas id="infrastructureChart" role="img" aria-label="Grafico della distribuzione degli stati dell’infrastruttura"></canvas></div>
                    </article>
                </div>
            </div>
            <p class="trend-empty d-none" id="trendEmpty">Non ci sono ancora misure sufficienti per disegnare i grafici.</p>
        </div>
    </section>
}

<div class="card panel-card mb-4">
    <div class="card-header panel-header"><span class="section-kicker">Inventario</span><span class="section-title">Stato infrastruttura</span></div>
    <div class="card-body">
        <div class="row g-3 text-center" id="infraPanel">
            <partial name="_InfraTile"
                     model="@(new ValueTuple<string,int,string,string>("Totali", Model.Infrastructure.TotalDevices, "secondary", "infraTotal"))" />
            <partial name="_InfraTile"
                     model="@(new ValueTuple<string,int,string,string>("Accesi", Model.Infrastructure.DevicesOn, "success", "infraOn"))" />
            <partial name="_InfraTile"
                     model="@(new ValueTuple<string,int,string,string>("Spenti", Model.Infrastructure.DevicesOff, "dark", "infraOff"))" />
            <partial name="_InfraTile"
                     model="@(new ValueTuple<string,int,string,string>("In arresto", Model.Infrastructure.DevicesShuttingDown, "warning", "infraShutting"))" />
            <partial name="_InfraTile"
                     model="@(new ValueTuple<string,int,string,string>("In avvio", Model.Infrastructure.DevicesStarting, "info", "infraStarting"))" />
            <partial name="_InfraTile"
                     model="@(new ValueTuple<string,int,string,string>("Non raggiungibili", Model.Infrastructure.DevicesUnreachable, "warning", "infraUnreachable"))" />
            <partial name="_InfraTile"
                     model="@(new ValueTuple<string,int,string,string>("Con errori", Model.Infrastructure.DevicesWithErrors, "danger", "infraErrors"))" />
            <partial name="_InfraTile"
                     model="@(new ValueTuple<string,int,string,string>("Stato ignoto", Model.Infrastructure.DevicesUnknown, "secondary", "infraUnknown"))" />
        </div>
    </div>
</div>

<div class="card panel-card mb-4 d-none" id="pendingStartupsCard">
    <div class="card-header panel-header"><span class="section-kicker">Azioni richieste</span><span class="section-title">Riaccensioni in attesa di approvazione</span></div>
    <div class="card-body">
        <p class="small text-body-secondary">
            L'alimentazione è stabile da tempo sufficiente, ma la policy richiede
            un'approvazione manuale prima di riaccendere i dispositivi (§12).
        </p>
        <div id="pendingStartupsList"></div>
    </div>
</div>

<div class="card panel-card">
    <div class="card-header panel-header"><span class="section-kicker">Cronologia</span><span class="section-title">Eventi recenti</span></div>
    <div class="card-body">
        <div id="eventsTable"></div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script src="~/lib/chartjs/chart.umd.min.js"></script>
<script src="~/js/dashboard.js" asp-append-version="true"></script>
}
