@model SequenceHeaderFormDto
@{
    var kind = (SequenceKind)ViewBag.Kind;
    ViewData["Title"] = Model.Id is null ? "Nuova sequenza" : $"Modifica {Model.Name}";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<form asp-action="SaveSequence" asp-route-kind="@kind" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label" asp-for="Name"></label>
                <input class="form-control" asp-for="Name" required />
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Description"></label>
                <textarea class="form-control" asp-for="Description" rows="2"></textarea>
            </div>
            <div class="form-check">
                <input class="form-check-input" asp-for="IsEnabled" />
                <label class="form-check-label" asp-for="IsEnabled"></label>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary">
            Salva e prosegui agli step
        </button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-kind="@kind">Annulla</a>
    </div>
</form>
