@using Microsoft.AspNetCore.Mvc.Rendering
@using UPSControlCenter.Core.Rules
@model ShutdownRuleFormDto
@{
    ViewData["Title"] = Model.Id is null ? "Nuova regola" : $"Modifica {Model.Name}";
    var sequences = ViewBag.Sequences as List<SelectListItem> ?? [];
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<form asp-action="Save" method="post" id="ruleForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-4">
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold">Identificazione</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" asp-for="Name"></label>
                        <input class="form-control" asp-for="Name" />
                        <span class="text-danger small" asp-validation-for="Name"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Description"></label>
                        <textarea class="form-control" asp-for="Description" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Priority"></label>
                        <input class="form-control" asp-for="Priority" />
                        <div class="form-text">Valori più bassi vengono valutati prima.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="TriggerSequenceId">Sequenza da avviare</label>
                        <select class="form-select" asp-for="TriggerSequenceId" asp-items="sequences">
                            <option value="">(usa la sequenza predefinita della policy)</option>
                        </select>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" asp-for="IsEnabled" />
                        <label class="form-check-label" asp-for="IsEnabled"></label>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold">Validità temporale</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" asp-for="TimeWindowsText">Fasce orarie</label>
                        <textarea class="form-control" asp-for="TimeWindowsText" rows="3"
                                  placeholder="22:00-06:00"></textarea>
                        <div class="form-text">
                            Una fascia per riga, formato HH:mm-HH:mm. Vuoto = sempre valida.
                        </div>
                    </div>
                    <div class="mb-0">
                        <label class="form-label">Giorni della settimana</label>
                        <div class="d-flex flex-wrap gap-3">
                            @{
                                string[] dayNames = ["Dom", "Lun", "Mar", "Mer", "Gio", "Ven", "Sab"];
                            }
                            @for (var i = 0; i < 7; i++)
                            {
                                var checked_ = Model.SelectedDays.Contains(i);
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedDays"
                                           value="@i" id="day@(i)" checked="@checked_" />
                                    <label class="form-check-label" for="day@(i)">@dayNames[i]</label>
                                </div>
                            }
                        </div>
                        <div class="form-text">Nessuna selezione = tutti i giorni.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Condizione</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" asp-for="UseAdvancedMode"
                               id="advancedToggle" />
                        <label class="form-check-label" for="advancedToggle">Modalità avanzata (JSON)</label>
                    </div>
                </div>
                <div class="card-body">
                    <div id="simpleBuilder" class="@(Model.UseAdvancedMode ? "d-none" : "")">
                        <div class="mb-3">
                            <label class="form-label">Operatore</label>
                            <select class="form-select" style="max-width: 200px" asp-for="TopOperator">
                                <option value="@NodeKind.And">And</option>
                                <option value="@NodeKind.Or">Or</option>
                            </select>
                            <div class="form-text">
                                AND: tutte le condizioni devono essere vere. OR: basta una.
                            </div>
                        </div>

                        <div id="conditionRows"></div>

                        <button type="button" class="btn btn-sm btn-outline-secondary mt-2" id="addCondition">
                            Aggiungi condizione
                        </button>
                    </div>

                    <div id="advancedBuilder" class="@(Model.UseAdvancedMode ? "" : "d-none")">
                        <label class="form-label" asp-for="RawConditionJson">JSON della condizione</label>
                        <textarea class="form-control" asp-for="RawConditionJson" rows="8"
                                  style="font-family: monospace"></textarea>
                        <div class="form-text">
                            Struttura <code>ConditionNode</code>: supporta AND/OR/NOT annidati, non
                            esprimibili nel builder semplice.
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="previewBtn">
                            Anteprima JSON
                        </button>
                        <pre class="mt-2 small d-none" id="previewOutput"></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Salva</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Annulla</a>
    </div>
</form>

<script id="existingSimpleConditions" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SimpleConditions))
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/rule-editor.js"></script>
}
