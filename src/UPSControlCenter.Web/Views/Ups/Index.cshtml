@model IReadOnlyList<UpsStatusDto>
@{
    ViewData["Title"] = "UPS";
}

<h1 class="h3 mb-3">UPS monitorati</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="alert">
        Nessun UPS configurato. Le impostazioni iniziali vengono create dal comando di
        migrazione; verificare che sia stato eseguito.
    </div>
}

@foreach (var ups in Model)
{
    <partial name="_UpsCard" model="ups" />
}
