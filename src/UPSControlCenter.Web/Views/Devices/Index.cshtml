@{
    ViewData["Title"] = "Dispositivi";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0">Dispositivi gestiti</h1>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" id="exportCsv">Esporta CSV</button>
        <a class="btn btn-primary" asp-action="Create">Nuovo dispositivo</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label" for="filterText">Ricerca</label>
                <input class="form-control" id="filterText" type="search"
                       placeholder="Nome, hostname, indirizzo IP…" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label" for="filterType">Tipologia</label>
                <select class="form-select" id="filterType">
                    <option value="">Tutte</option>
                    @foreach (var type in Enum.GetValues<DeviceType>())
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label" for="filterState">Stato</label>
                <select class="form-select" id="filterState">
                    <option value="">Tutti</option>
                    @foreach (var state in Enum.GetValues<DeviceState>())
                    {
                        <option value="@state">@state</option>
                    }
                </select>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div id="devicesTable"></div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script src="~/js/devices.js"></script>
}
