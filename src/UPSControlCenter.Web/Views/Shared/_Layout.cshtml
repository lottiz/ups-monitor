@using Microsoft.AspNetCore.Mvc.ViewFeatures
<!DOCTYPE html>
<html lang="it" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · UPS Control Center</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/tabulator/tabulator.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-secondary">
    <div class="container-fluid">
        <a class="navbar-brand fw-semibold" asp-controller="Dashboard" asp-action="Index">
            <span aria-hidden="true">⚡</span> UPS Control Center
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false"
                aria-label="Apri il menu di navigazione">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Ups" asp-action="Index">UPS</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Devices" asp-action="Index">Dispositivi</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Simulator" asp-action="Index">Simulatore</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Configuration" asp-action="Index">Configurazioni</a>
                </li>
            </ul>

            <div class="d-flex align-items-center gap-3">
                <span id="modeBadge" class="badge text-bg-secondary" title="Modalità di esecuzione">
                    Modalità: verifica in corso…
                </span>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </div>
</nav>

<main class="container-fluid py-4" role="main">
    @RenderBody()
</main>

<footer class="border-top py-3 mt-4 text-body-secondary">
    <div class="container-fluid d-flex flex-wrap justify-content-between">
        <span>UPS Control Center — monitoraggio UPS e orchestrazione dell'alimentazione</span>
        <span id="connectionState" class="text-body-secondary">Connessione in tempo reale: non attiva</span>
    </div>
</footer>

<div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3"></div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/signalr/signalr.min.js"></script>
<script src="~/lib/tabulator/tabulator.min.js"></script>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
