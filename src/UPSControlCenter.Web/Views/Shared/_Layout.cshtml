@using Microsoft.AspNetCore.Mvc.ViewFeatures
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string NavClass(params string[] controllers) =>
        controllers.Contains(currentController, StringComparer.OrdinalIgnoreCase)
            ? "nav-link active"
            : "nav-link";
}
<!DOCTYPE html>
<html lang="it" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · UPS Control Center</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/tabulator/tabulator.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="app-shell">
<nav class="navbar navbar-expand-lg navbar-dark app-navbar">
    <div class="container-fluid">
        <a class="navbar-brand app-brand" asp-controller="Dashboard" asp-action="Index">
            <span class="brand-mark" aria-hidden="true">ϟ</span>
            <span class="brand-copy">
                <span class="brand-name">UPS Control Center</span>
                <span class="brand-subtitle">Energy operations</span>
            </span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false"
                aria-label="Apri il menu di navigazione">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="@NavClass("Dashboard")" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="@NavClass("Ups")" asp-controller="Ups" asp-action="Index">UPS</a>
                </li>
                <li class="nav-item">
                    <a class="@NavClass("Devices")" asp-controller="Devices" asp-action="Index">Dispositivi</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="@NavClass("Rules", "Sequences") dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                        Regole e sequenze
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-controller="Rules" asp-action="Index">Regole di spegnimento</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-controller="Sequences" asp-action="Index" asp-route-kind="Shutdown">Sequenze di spegnimento</a></li>
                        <li><a class="dropdown-item" asp-controller="Sequences" asp-action="Index" asp-route-kind="Startup">Sequenze di riaccensione</a></li>
                    </ul>
                </li>
                <li class="nav-item">
                    <a class="@NavClass("Simulator")" asp-controller="Simulator" asp-action="Index">Simulatore</a>
                </li>
                <li class="nav-item">
                    <a class="@NavClass("Configuration")" asp-controller="Configuration" asp-action="Index">Configurazioni</a>
                </li>
                <li class="nav-item">
                    <a class="@NavClass("Audit")" asp-controller="Audit" asp-action="Index">Audit</a>
                </li>
            </ul>

            <div class="d-flex align-items-center gap-3">
                <span id="modeBadge" class="badge mode-pill text-bg-secondary" title="Modalità di esecuzione">
                    Modalità: verifica in corso…
                </span>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </div>
</nav>

<main class="container-fluid app-main" role="main">
    @RenderBody()
</main>

<footer class="app-footer text-body-secondary">
    <div class="container-fluid d-flex flex-wrap justify-content-between">
        <span>UPS Control Center <span class="footer-separator">/</span> Supervisione energetica</span>
        <span class="connection-indicator"><span id="connectionDot" class="connection-dot connection-off" aria-hidden="true"></span><span id="connectionState">Connessione in tempo reale: non attiva</span></span>
    </div>
</footer>

<div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3"></div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/signalr/signalr.min.js"></script>
<script src="~/lib/tabulator/tabulator.min.js"></script>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
