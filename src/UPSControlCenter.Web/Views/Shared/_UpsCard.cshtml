@model UpsStatusDto
@inject DisplayTimeFormatter DisplayTime
@{
    // Il colore comunica lo stato a colpo d'occhio, ma il testo resta sempre esplicito:
    // il colore da solo non è accessibile.
    var (badgeClass, badgeText) = Model switch
    {
        { IsStale: true } => ("text-bg-secondary", "Dato obsoleto"),
        { NutConnected: false } => ("text-bg-secondary", "NUT non connesso"),
        { IsLowBattery: true } => ("text-bg-danger", "Batteria scarica"),
        { IsOnBattery: true } => ("text-bg-warning", "Su batteria"),
        { IsOnLine: true } => ("text-bg-success", "Alimentazione di rete"),
        _ => ("text-bg-secondary", "Stato non determinabile")
    };

    string Fmt(decimal? value, string unit) =>
        value is { } v ? $"{v:0.##} {unit}" : "non disponibile";

    string FmtRuntime(int? seconds) =>
        seconds is { } s ? TimeSpan.FromSeconds(s).ToString(@"hh\:mm\:ss") : "non disponibile";
}

<div class="ups-status-card mb-3" data-ups-id="@Model.Id">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
        <div>
            <h2 class="h5 mb-1">@Model.Name</h2>
            <div class="small text-body-secondary">
                @(Model.Manufacturer ?? "produttore non disponibile") ·
                @(Model.Model ?? "modello non disponibile")
                @if (!string.IsNullOrWhiteSpace(Model.Serial))
                {
                    <text>· S/N @Model.Serial</text>
                }
            </div>
        </div>
        <div class="text-end">
            <span class="badge status-pill @badgeClass" data-role="status-badge">@badgeText</span>
            <div class="small text-body-secondary mt-1" data-role="status-text">@Model.StatusText</div>
        </div>
    </div>

    @if (Model.IsStale || !Model.NutConnected)
    {
        <div class="alert alert-warning py-2 small" role="alert">
            @(Model.NutError ?? "Il dato mostrato non è verificabile come attuale.")
        </div>
    }

    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-2 small metric-grid">
        <div class="metric-battery"><span class="metric-label">Carica batteria</span><span class="metric-value" data-role="charge">@Fmt(Model.BatteryChargePercent, "%")</span></div>
        <div class="metric-runtime"><span class="metric-label">Autonomia residua</span><span class="metric-value" data-role="runtime">@FmtRuntime(Model.BatteryRuntimeSeconds)</span></div>
        <div class="metric-load"><span class="metric-label">Carico</span><span class="metric-value" data-role="load">@Fmt(Model.LoadPercent, "%")</span></div>
        <div class="metric-power"><span class="metric-label">Potenza</span><span class="metric-value">@Fmt(Model.RealPowerWatts, "W")</span></div>
        <div class="metric-voltage"><span class="metric-label">Tensione ingresso</span><span class="metric-value" data-role="vin">@Fmt(Model.InputVoltage, "V")</span></div>
        <div class="metric-voltage"><span class="metric-label">Tensione uscita</span><span class="metric-value">@Fmt(Model.OutputVoltage, "V")</span></div>
        <div class="metric-frequency"><span class="metric-label">Frequenza ingresso</span><span class="metric-value">@Fmt(Model.InputFrequency, "Hz")</span></div>
        <div class="metric-battery-voltage"><span class="metric-label">Tensione batteria</span><span class="metric-value">@Fmt(Model.BatteryVoltage, "V")</span></div>
    </div>

    @if (Model.PhaseData.Count > 0)
    {
        <details class="mt-3">
            <summary class="small">Dati trifase (@Model.PhaseData.Count valori)</summary>
            <dl class="row small mt-2 mb-0">
                @foreach (var kv in Model.PhaseData.OrderBy(k => k.Key))
                {
                    <dt class="col-6 col-md-4 text-truncate">@kv.Key</dt>
                    <dd class="col-6 col-md-8">@kv.Value</dd>
                }
            </dl>
        </details>
    }

    <div class="small text-body-secondary mt-3">
        Ultima comunicazione:
        <span data-role="last-comm">
            @DisplayTime.Format(Model.LastCommunicationAt, "dd/MM/yyyy HH:mm:ss", "mai")
        </span>
        · <a asp-controller="Ups" asp-action="Details" asp-route-id="@Model.Id">Dettagli</a>
    </div>
</div>
