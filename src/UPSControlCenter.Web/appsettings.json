{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Execution": {
    "Mode": "DryRun"
  },
  "Nut": {
    "Host": "host.docker.internal",
    "Port": 3493,
    "UpsName": "riello",
    "TimeoutSeconds": 5
  },
  "SafetySync": {
    "HmacKeyBase64": "",
    "PullIntervalSeconds": 60,
    "StaleSyncWarningSeconds": 900
  },
  "SafetyApi": {
    "AgentToken": ""
  },
  "KillSwitch": {
    "SentinelPath": "/var/lib/ups-control-center/AUTOMATION_DISABLED"
  },
  "DataProtection": {
    "KeyRingPath": "/keys"
  },
  "NetworkRestriction": {
    "IsEnabled": true,
    "AllowedNetworks": [
      "10.0.0.0/24",
      "172.16.10.0/24",
      "192.168.98.0/24",
      "192.168.114.0/24",
      "127.0.0.0/8",
      "::1/128",
      "172.16.0.0/12"
    ]
  },
  "KnownProxies": [],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
